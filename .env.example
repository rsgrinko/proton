# Настройки приложения. Скопируйте этот файл в .env и правьте его —
# сам .env в репозиторий не попадает, в нём пароли и ключи.

APP_NAME="Proton"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Moscow

# Ключ подписи кук и шифрования секретов в базе.
# Создать: php bin/proton app:key
APP_KEY=

# Адреса своих прокси через запятую (можно сети CIDR). Только их заголовку
# X-Forwarded-For можно верить, иначе адрес клиента подделает кто угодно.
TRUSTED_PROXIES=

# Умолчания для php bin/proton serve
SERVE_HOST=127.0.0.1
SERVE_PORT=8000

# --- База данных ------------------------------------------------------------
# sqlite (по умолчанию, ничего настраивать не нужно) или mysql
DB_DRIVER=sqlite
DB_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=proton
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Вход и сеансы ----------------------------------------------------------
# Общее начало имён кук: два приложения на одном домене не должны мешать друг другу
AUTH_COOKIE_PREFIX=proton
AUTH_SESSION_LIFETIME=43200
AUTH_REMEMBER_DAYS=30
AUTH_PASSWORD_MIN=6
AUTH_MAX_ATTEMPTS=10
AUTH_ATTEMPTS_WINDOW=900
AUTH_SESSIONS_KEEP_DAYS=60

# Открыта ли регистрация и нужно ли подтверждать почту письмом
AUTH_REGISTRATION=true
AUTH_VERIFY_EMAIL=false
AUTH_LINK_LIFETIME=86400

# --- Почта ------------------------------------------------------------------
# mail   — функция mail() (работает везде, ничего настраивать не нужно)
# smtp   — свой SMTP-клиент
# mailer — внешний почтовый сервис по HTTP API
# log    — письма складываются файлами в var/log/mail (разработка)
# null   — письма выбрасываются (тесты)
MAIL_DRIVER=log
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Proton"

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# пусто | ssl (порт 465) | tls (порт 587)
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=30
SMTP_VERIFY_PEER=true
SMTP_HELO=
SMTP_SESSION_LIMIT=100

# Почтовый сервис (драйвер mailer)
MAIL_SERVICE_URL=
MAIL_SERVICE_KEY=
MAIL_SERVICE_TIMEOUT=10

# --- Очередь и расписание ---------------------------------------------------
QUEUE_SLEEP=3
QUEUE_WORKER_LIFETIME=3600
QUEUE_MAINTENANCE_INTERVAL=300
QUEUE_STUCK_MINUTES=15
QUEUE_KEEP_DAYS=7

# --- Прочее -----------------------------------------------------------------
# file | database | array
CACHE_DRIVER=file
FILES_MAX_SIZE=5242880

# debug | info | warning | error
LOG_LEVEL=info
LOG_KEEP_DAYS=30
AUDIT_KEEP_DAYS=180
UI_PER_PAGE=25

# Выгрузка списков в CSV: разделитель и предел строк на файл
EXPORT_DELIMITER=;
EXPORT_MAX_ROWS=20000

# Загрузка списков из CSV: сколько строк принимаем за раз
IMPORT_MAX_ROWS=5000

# Корзина: через сколько дней удалённое добивается окончательно (0 — никогда)
TRASH_KEEP_DAYS=30

# Безопасность: закрытые адреса, автоблокировка перебора, журнал событий
SECURITY_BLOCKLIST=true
SECURITY_AUTOBLOCK_ATTEMPTS=30
SECURITY_AUTOBLOCK_WINDOW=60
SECURITY_AUTOBLOCK_MINUTES=60
SECURITY_KEEP_DAYS=60
# За сколько дней предупредить владельца, что ключ API скоро истечёт
KEY_EXPIRY_NOTICE_DAYS=7

# Показатели работы: счётчики запросов и порог «медленного» ответа
METRICS_ENABLED=true
METRICS_SLOW_MS=1000

# Присмотр за порогами: о выходе за край узнают те, у кого право system.manage
MONITOR_ENABLED=true
MONITOR_INTERVAL=300
MONITOR_REPEAT_MINUTES=60
MONITOR_FAILED_JOBS=10
MONITOR_QUEUE_BACKLOG=500
MONITOR_ERRORS=20

# --- Тесты ------------------------------------------------------------------
# По умолчанию тесты идут на своей базе SQLite в памяти. MySQL включается
# только этими переменными — и только на отдельной базе: тесты сносят записи
# целыми таблицами.
TEST_DB_DRIVER=sqlite
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_DATABASE=
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=

# --- Обращения к чужим сервисам ---------------------------------------------
# Путь к набору корневых сертификатов (cacert.pem). Нужен там, где у PHP нет
# своего хранилища — обычное дело на Windows: без него любой https-запрос
# падает на «unable to get local issuer certificate».
# Взять: https://curl.se/ca/cacert.pem
HTTP_CA_BUNDLE=
HTTP_TIMEOUT=10
# Проверку сертификата выключать не надо: без неё ключи интеграций достанутся
# любому, кто встанет посередине
HTTP_VERIFY_PEER=true

# --- Вебхуки ----------------------------------------------------------------
WEBHOOKS_ENABLED=true
WEBHOOKS_TIMEOUT=10
WEBHOOKS_ATTEMPTS=5
# Подписка, не ответившая столько раз подряд, отключается сама (0 — никогда)
WEBHOOKS_DISABLE_AFTER=20
WEBHOOKS_KEEP_DAYS=14
# Очередь для посылок: чужой сервер отвечает долго, и письма его не ждут.
# Воркер разбирает обе очереди: worker --queue=default,webhooks
WEBHOOKS_QUEUE=webhooks

# --- Уведомления ------------------------------------------------------------
# Сколько держать прочитанные уведомления в ленте (непрочитанные не убираются)
NOTIFICATIONS_KEEP_DAYS=90

# --- Резервные копии --------------------------------------------------------
# Сколько копий держать: лишние удаляются после новой
BACKUP_KEEP=7
# Во сколько делать копию каждый день, например 03:30. Пусто — не делать
BACKUP_SCHEDULE=
